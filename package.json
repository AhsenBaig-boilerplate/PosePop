{
  "name": "posepop",
  "version": "1.5.2",
  "private": true,
  "description": "Strike a pose, pop into a block world, and take home a sticker or photo print.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "verify": "node scripts/verify.mjs",
    "test": "npm run build && npm run verify && npm run test:unit",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "start": "npm run build && node scripts/serve.mjs",
    "releases": "node scripts/releases.mjs"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/pixelify-sans": "5.3.0",
    "@playwright/test": "1.63.0",
    "@tensorflow/tfjs": "4.22.0",
    "emoji-datasource-google": "16.0.0",
    "three": "0.128.0"
  }
}
